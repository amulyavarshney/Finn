# FINN reads whichever of these is present, in this order of preference.
# Without any key the app still runs: classification and summaries fall back to
# deterministic rules, and LLM-only research sections report themselves unavailable.

GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional: override the default provider ("groq" | "openai" | "anthropic" | "gemini").
# FINN_LLM_PROVIDER=groq

# Optional: override the model behind each tier. Worth knowing about because
# Groq retires model ids periodically — the Llama 3.x ids this shipped with
# now 404.
# FINN_GROQ_FAST=openai/gpt-oss-20b
# FINN_GROQ_STRONG=openai/gpt-oss-120b

# Optional: client-side rate limiting, defaulted just under Groq's free tier
# (30 requests and 8,000 tokens per minute). Raise these on a paid tier.
# FINN_LLM_RPM=25
# FINN_LLM_TPM=7000
